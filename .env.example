# ==============================================================================
# MMI-Gram Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with authorized credentials.
# NOTE: MMI-Gram runs 100% offline by default using local fixtures and requires
# no credentials or network access for testing and offline evaluation.
# Live cloud execution is strictly opt-in and requires explicit user authorization.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# Required only for live GCS media uploads and Vertex AI / Gemini API execution.
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID
GCS_PROJECT_ID="your-gcp-project-id"
projectID="your-gcp-project-id"
GCS_REGION="us-central1"

# Service Account Credentials:
# Path to your downloaded service account JSON key file (e.g. ./service_account.json)
GOOGLE_APPLICATION_CREDENTIALS="./service_account.json"

# Cloud Storage Bucket Name (must have storage.objects.create and storage.objects.get)
GCS_BUCKET="your-earthquake-bucket"

# Signed URL expiration in seconds (default: 36000 = 10 hours)
SIGNED_URL_TTL="36000"

# BigQuery Dataset & Table (optional, for persistent storage of map records)
BQ_DATASET="earthquake_dataset"
BQ_TABLE="map_store"

# ------------------------------------------------------------------------------
# Gemini & LLM Model Configuration
# ------------------------------------------------------------------------------
# Default model: gemini-3.8-flash (with explicit HIGH thinking via google-genai on Vertex AI)
# Fallback models for comparative benchmarking: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_THINKING_LEVEL="HIGH"

# Optional: Google Gemini API key if using standalone API instead of Vertex AI ADC
# GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# Vector Search & Retrieval (Pinecone)
# ------------------------------------------------------------------------------
# Pinecone API key for retrieving historical MMI reference calibration documents
PINECONE_API="your-pinecone-api-key"
# Reference Retrieval Mode: 'full_scale' (Default, recommended: all 10 standard definitions without exclusions) or 'vector_search' (top-k semantic search)
MMI_REFERENCE_MODE="full_scale"

# ------------------------------------------------------------------------------
# Web Search Fallback (Tavily)
# ------------------------------------------------------------------------------
# Tavily API key for supplementary context searches during CRAG traversal
TAVILY_API_KEY="your-tavily-api-key"

# ------------------------------------------------------------------------------
# Local Pipeline & Review Settings
# ------------------------------------------------------------------------------
# Path for persistent Human-in-the-Loop review queue storage
MMI_GRAM_REVIEW_PATH="data/review_queue.json"

# Default batch processing pace (delay in seconds between requests)
MMI_GRAM_BATCH_PACE="2.0"
