# ==============================================================================
# MMI-Gram Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with authorized credentials:
#   cp .env.example .env
#
# SCIENTIFIC & SECURITY PRINCIPLES:
# 1. MMI-Gram runs 100% offline by default using local fixtures and requires
#    ZERO credentials or network access for tests and offline evaluations.
# 2. Preferred live architecture uses local Google AI Studio with Gemini 3.8 Flash
#    and a versioned local MMI reference knowledge base.
# 3. Third-party cloud storage (GCS) and vector databases (Pinecone) are bypassed
#    in local mode. Local PDFs are sent directly as binary media parts.
# 4. Paid Google Maps Geocoding is DISABLED by default (ENABLE_LIVE_GEOCODING=false).
#    Coordinates are extracted directly from PDF text, DMS/decimal notes, and map links.
# 5. Strict budget ceilings and checkpointing prevent runaway costs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Preferred Primary Provider: Google AI Studio (Local Direct Inference)
# ------------------------------------------------------------------------------
# Provider Selection: 'ai_studio' (default/recommended) or 'vertex_ai'
# Note: Provider preflight enforces this setting; the system never silently falls back.
GEMINI_PROVIDER="ai_studio"

# Google AI Studio API Key (from https://aistudio.google.com/app/apikey)
# Required ONLY when executing live Gemini inference (--live mode).
GEMINI_API_KEY="your-google-ai-studio-api-key"

# Intended Model: gemini-3.8-flash (enforced by provider preflight)
GEMINI_MODEL="gemini-3.8-flash"

# Model Extended Thinking Level: 'HIGH' (enforces rigorous chain-of-thought seismological reasoning)
GEMINI_THINKING_LEVEL="HIGH"

# ------------------------------------------------------------------------------
# 2. Local MMI Reference Knowledge Base (Default & Recommended)
# ------------------------------------------------------------------------------
# Reference Retrieval Mode:
#   'full_scale'    - (Default, recommended) All 10 authoritative MMI definitions (Wood & Neumann 1931)
#                     loaded from versioned local asset (src/mmigram/assets/mmi_scale_definitions.json).
#                     Zero network, zero Pinecone credentials required.
#   'vector_search' - (Legacy/optional) Semantic top-k search against Pinecone index.
MMI_REFERENCE_MODE="full_scale"

# ------------------------------------------------------------------------------
# 3. Batch Execution, Pacing, and Budget Controls
# ------------------------------------------------------------------------------
# Strict dollar expenditure ceilings (enforced by BatchRunner before each API dispatch):
MMI_GRAM_BUDGET_LIMIT_PILOT="3.00"   # Pilot run spending limit ($3.00 USD)
MMI_GRAM_BUDGET_LIMIT_FULL="25.00"   # Full dataset spending ceiling ($25.00 USD)

# Inter-request delay in seconds to respect API rate limits and quotas:
MMI_GRAM_BATCH_PACE="2.0"

# Maximum retry attempts with exponential backoff on transient 429/503 errors:
MMI_GRAM_MAX_RETRIES="3"

# Persistent checkpoint file for batch state and resume support:
MMI_GRAM_CHECKPOINT_PATH="data/events/us7000pn9s/batch_checkpoint.json"

# Persistent Human-in-the-Loop review queue storage:
MMI_GRAM_REVIEW_PATH="data/review_queue.json"

# ------------------------------------------------------------------------------
# 4. Google Maps Geocoding (OPTIONAL & DISABLED BY DEFAULT)
# ------------------------------------------------------------------------------
# Feature flag: Set to 'true' ONLY if paid Google Maps Geocoding API lookups are explicitly approved.
# When 'false' (default), geocoding network calls are completely blocked. Coordinates are
# resolved exclusively via PDF text extraction, DMS parsing, and Google Maps URL parsing.
ENABLE_LIVE_GEOCODING="false"

# Google Maps API Key (Optional; required only if ENABLE_LIVE_GEOCODING="true"):
# GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ------------------------------------------------------------------------------
# 5. Optional & Legacy Integrations (NOT Required for AI Studio Inference)
# ------------------------------------------------------------------------------
# Google Cloud Platform / Vertex AI (Optional institutional alternative to AI Studio):
# projectID="your-gcp-project-id"
# GCS_PROJECT_ID="your-gcp-project-id"
# GCS_REGION="us-central1"
# GOOGLE_APPLICATION_CREDENTIALS="./service_account.json"

# Google Cloud Storage (Legacy media upload; bypassed by direct binary streaming in AI Studio):
# GCS_BUCKET="your-earthquake-bucket"
# SIGNED_URL_TTL="36000"

# BigQuery (Optional map database storage):
# BQ_DATASET="earthquake_dataset"
# BQ_TABLE="map_store"

# Pinecone Vector Database (Legacy; required only if MMI_REFERENCE_MODE="vector_search"):
# PINECONE_API="your-pinecone-api-key"

# Tavily Web Search (Legacy search traversal; not used in standard direct PDF pipeline):
# TAVILY_API_KEY="your-tavily-api-key"
